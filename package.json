{
  "name": "smart-face-attendance-system",
  "version": "1.0.0",
  "description": "Production Ready Face Recognition Smart Attendance Management System for College Faculty & Students",
  "main": "server/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/src/server.js",
    "client:dev": "npm --prefix client run dev",
    "start": "node server/src/server.js",
    "seed": "node server/src/seed.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "face-recognition",
    "attendance-system",
    "smart-classroom",
    "react",
    "express",
    "mongodb",
    "vite",
    "exceljs"
  ],
  "author": "College Engineering Tech Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
