# ==============================================================================
# SMART FACE ATTENDANCE MANAGEMENT SYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Persistent Cloud Storage)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_attendance_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:YourSecureAtlasPassword@cluster0.mongodb.net/smart_attendance_db?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a 64+ char random string)
JWT_SECRET=super_secret_jwt_encryption_key_production_2026_smart_attendance_system
JWT_EXPIRES_IN=24h

# CORS & Production Frontend Origin
# For Deployed Website: https://smart-attendance-portal.vercel.app
CLIENT_URL=https://smart-attendance-portal.vercel.app

# Regional Timezone Configuration
TIMEZONE=Asia/Kolkata

# Biometric Matching Precision Threshold (Euclidean distance threshold: 0.45 - 0.60)
FACE_MATCH_THRESHOLD=0.55

# Frontend Client Environment Variables (for client/.env or Vercel / Netlify environment settings)
VITE_API_URL=https://smart-attendance-api.onrender.com/api
